set default-list
set ignore-comments

# Build the Worker as `wrangler deploy` builds it.
build:
    worker-build --release

# Validate the Worker's shape without deploying: the configuration, every binding and the bundle.
dry-run:
    wrangler deploy --dry-run

# The Worker as a release ships it, into `out` (a release's engine/): the module and its WebAssembly (not worker-build's shim.mjs or package.json, which nothing deploys).
artifact out: build
    rm -rf "{{ out }}"
    mkdir -p "{{ out }}"
    cp build/index.js build/index_bg.wasm "{{ out }}/"
