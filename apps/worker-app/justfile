set default-list
set ignore-comments

# Assemble the static files (apps/worker/worker-assets, which wrangler.toml points at).
assets:
    {{ just_executable() }} ../worker/ assets

# Build the Worker as `wrangler deploy` builds it.
build:
    worker-build --release

# Validate the Worker's shape without deploying: the configuration, every binding, the bundle and the static files.
dry-run: assets
    wrangler deploy --dry-run

# The Worker as a release ships it, into `out` (a release's app/): the module and its WebAssembly (not worker-build's shim.mjs or package.json, which nothing deploys) and the static files.
artifact out: assets build
    rm -rf "{{ out }}"
    mkdir -p "{{ out }}"
    cp build/index.js build/index_bg.wasm "{{ out }}/"
    cp -R ../worker/worker-assets "{{ out }}/assets"
